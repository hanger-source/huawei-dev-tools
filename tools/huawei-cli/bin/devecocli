#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
export PATH="$SCRIPT_DIR/../../../official/command-line-tools/tool/node/bin:$PATH"
if [ -z "${DEVECO_HOME:-}" ] && [ -z "${DEVECO_CLI_CLT_PATH:-}" ]; then
  DEVECO_CLI_CLT_PATH=$(CDPATH='' cd -- "$SCRIPT_DIR/../../../official/command-line-tools" && pwd)
  export DEVECO_CLI_CLT_PATH
fi
exec "$SCRIPT_DIR/../../../official/command-line-tools/tool/node/bin/node" "$SCRIPT_DIR/../node_modules/@deveco/deveco-cli-common/dist/cli.js" "$@"
